# Standard Postgres connection string. On an always-on VM, local PostgreSQL is
# recommended so frequent polling cannot exhaust a hosted compute allowance.
DATABASE_URL=postgresql://nhs_jobs:replace-with-a-long-password@127.0.0.1:5432/nhs_jobs
# auto disables TLS only for localhost/127.0.0.1 and requires it for remote DBs.
# Set explicitly to require or disable only when your provider/setup needs it.
DATABASE_SSL=auto
DB_CONNECT_TIMEOUT_SECONDS=30
DB_RETENTION_DAYS=60
# Optional deployment activation boundary. Pending jobs discovered before this
# ISO-8601 timestamp remain stored but are not sent to WhatsApp.
DELIVERY_NOT_BEFORE=
HTTP_TIMEOUT_MS=30000
ENABLE_BROWSER_FALLBACK=true
BROWSER_TIMEOUT_MS=15000
BROWSER_PROFILE_DIR=.cache/browser-profile

# Normal WhatsApp group JID. You get this after the Baileys sender account joins
# the group. It usually looks like 120363xxxxxxxxxxxx@g.us.
WHATSAPP_GROUP_JID=120363xxxxxxxxxxxx@g.us
# Keep this on persistent disk for Baileys. On a VPS, /opt/nhs-jobs/auth_info is a good value.
WHATSAPP_AUTH_DIR=auth_info
# Optional expected sender phone number, digits only or with +. Used for startup logging checks.
# It is also required by `npm run whatsapp:pair` to generate a one-time pairing code.
WHATSAPP_SENDER_NUMBER=923046983328

# Default search behavior. Keep this comma-separated list focused; broad terms
# like "fellow", "senior", or "jcf" are intentionally not used.
# Exact "Clinical Fellow" is automatically searched only on NHS Scotland.
# Any job title containing "Senior" is excluded.
SEARCH_KEYWORDS=Resident Doctor,Trust Doctor,Trust Grade Doctor,Locally Employed Doctor,Junior Clinical Fellow,Clinical Fellow,Clinical Research Fellow,Clinical Teaching Fellow,Clinical Development Fellow,Simulation Fellow,Foundation Doctor,Foundation Year 1,Foundation Year 2,FY3,SHO,Core Trainee,ST1
# NHS Jobs can return broad first-page matches, so the scraper walks sorted pages.
JOBS_NHS_UK_MAX_PAGES=20
HSCNI_MAX_PAGES=5
NHS_SCOTLAND_MAX_PAGES=8
# Two-minute polling is suitable with local PostgreSQL. If you keep Neon Free,
# use at least 15 minutes so its five-minute scale-to-zero window can save compute.
SCRAPE_INTERVAL_CRON=*/2 * * * *

# Keep sends human-paced.
SEND_MIN_DELAY_MS=3000
SEND_MAX_DELAY_MS=6000

# Use true while testing the scrape/database pipeline without sending WhatsApp messages.
DRY_RUN_SENDS=false
# Defaults to true on Vercel so Baileys does not try to write auth files there. Use false on a VPS.
DISABLE_WHATSAPP_SENDS=false

# Optional: set this in Vercel if you want to protect /api/cron manual runs.
# Then call it with Authorization: Bearer your-secret.
CRON_SECRET=

# Logging.
LOG_LEVEL=info

# Optional source toggles.
ENABLE_HEALTHJOBSUK=true
ENABLE_JOBS_NHS_UK=true
ENABLE_NHS_SCOTLAND=true
ENABLE_NHSJOBS_COM=true
ENABLE_HSCNI=true
